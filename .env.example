LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash

EMAIL_SENDER=your_gmail_address@gmail.com
EMAIL_PASSWORD=your_16_letter_gmail_app_password
EMAIL_RECEIVER=where_to_receive_digest@gmail.com

APP_NAME=AI Briefing Agent
DEBUG=True

DIGEST_TIME=08:00
ALERT_INTERVAL_MINUTES=30

USE_EMBEDDINGS=True
EMBEDDING_MODEL=gemini-embedding-001
SEMANTIC_MIN_SCORE=0.55

INCLUDE_VIDEOS=True
VIDEO_MAX_PER_DIGEST=3

WEEKLY_ENABLED=True
WEEKLY_DAY=sun
WEEKLY_TIME=09:00

# Cloud par email: Resend API key (khali = Gmail SMTP)
RESEND_API_KEY=
RESEND_FROM=AI Briefing <onboarding@resend.dev>

# Personalization: comma-separated keywords
INTERESTS=

# User accounts: long random string, never commit the real one
AUTH_SECRET=

# Rate limiting (0 = off), proxy aur logging
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=300
TRUST_PROXY_HEADERS=false
LOG_LEVEL=INFO
LOG_JSON=true

# Purana data kitne din baad delete ho (0 = band)
RETENTION_DAYS=90

# Core endpoints ki hifazat (khali = khule hain) aur dashboard ka password
API_KEY=
DASHBOARD_PASSWORD=

# Telegram alerts (optional): @BotFather se token, apni chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Error alerts (Telegram + email) aur research ka follow-up search
ERROR_ALERTS=true
ERROR_ALERT_COOLDOWN_MINUTES=60
RESEARCH_FOLLOWUP=true

# Optional PostgreSQL connection. Khali chhorne par SQLite use hota hai.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Auto-added by scripts.sync_env_example
EMBEDDING_DIM=768
DATABASE_URL=sqlite:///briefing.db
AUTH_TOKEN_HOURS=72

# Auto-added by scripts.sync_env_example
DEMO_MODE=false

# Auto-added by scripts.sync_env_example
RESEARCH_WEB=false

# Auto-added by scripts.sync_env_example
DIGEST_WEB_CHECK=false

# true = rate limit hits database mein (restart par reset nahi hote; PostgreSQL par use karein)
RATE_LIMIT_PERSISTENT=false
